{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/platform/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/platform/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/platform/?", "dest": "/index.html" },
    { "src": "/platform/(.*)", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}

